{
  "name": "La Partideta",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "node scripts/codex-history.mjs --start",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "La Partideta", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
